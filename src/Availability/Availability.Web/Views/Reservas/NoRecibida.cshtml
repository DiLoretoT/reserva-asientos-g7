@* Resultado de una solicitud que no se registró porque el asiento no existe. Con el broker
   caído la solicitud igual queda registrada (patrón Outbox), así que ese caso va a la página
   de solicitud recibida. Los textos vienen decididos por el presenter. *@
@model Availability.Presenters.SolicitarReserva.SolicitarReservaViewModel

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="estado-vacio">
    <h1 class="estado-vacio__titulo">@Model.Titulo</h1>

    @if (Model.AsientoTexto is not null)
    {
        <p>@Model.AsientoTexto</p>
    }

    @* role="alert" porque es un error que el usuario tiene que conocer para decidir qué hacer. *@
    <p role="alert">@Model.Mensaje</p>

    <a class="boton" asp-controller="Eventos" asp-action="Asientos" asp-route-id="@Model.EventoId">
        Volver al mapa
    </a>
</div>

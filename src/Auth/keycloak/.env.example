# Copiar este archivo como .env (el .env no se sube al repo).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Client secrets de Keycloak (los usan Availability y Booking para pedir tokens).
# Cada integrante genera los suyos: sirve cualquier valor, siempre que sea el mismo
# que guarda en los user-secrets del servicio (Keycloak:ClientSecret).
# Por ejemplo, con: openssl rand -hex 24
AVAILABILITY_WEB_CLIENT_SECRET=cambiar
BOOKING_API_CLIENT_SECRET=cambiar
